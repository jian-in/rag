# ============================================================
# RAG 知识库系统 - 环境变量配置
# ============================================================
# 复制此文件为 .env 并填入你的 API Key
# cp .env.example .env

# [必填] OpenAI API Key（或兼容接口的 Key）
OPENAI_API_KEY=sk-your-api-key-here

# [可选] 自定义 API 端点（用于本地模型或代理服务）
# OPENAI_API_BASE=https://your-custom-endpoint/v1

# [可选] LLM 模型名称，默认 gpt-4o-mini
# LLM_MODEL_NAME=gpt-4o-mini

# [可选] LLM 温度参数，RAG 场景建议 0
# LLM_TEMPERATURE=0

# [可选] Embedding 模型（默认使用硅基流动 SiliconFlow + BAAI/bge-m3）
# SILICONFLOW_API_KEY=your-siliconflow-key-here
# EMBEDDING_MODEL_NAME=BAAI/bge-m3
# EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=your-siliconflow-key-here
# EMBEDDING_DIMENSION=1024

# [可选] 分块参数
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200

# [可选] 检索参数
# RETRIEVAL_TOP_K=5
# MMR_LAMBDA=0.6

# [可选] 重排序（默认使用硅基流动 SiliconFlow + BAAI/bge-reranker-v2-m3）
# ENABLE_RERANKER=false
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# RERANKER_PROVIDER=siliconflow
# RERANKER_MAX_CHUNKS_PER_DOC=1024
# RERANKER_OVERLAP_TOKENS=60
# [可选] 改用 Cohere 重排序时填写
# COHERE_API_KEY=your-cohere-key-here
# RERANKER_TOP_N=3

# ============================================================
# Web UI / REST API（main.py，默认仅本机 127.0.0.1:7860）
# ============================================================
# 开放到局域网前务必同时设置 RAG_ALLOWED_HOSTS 和 RAG_API_TOKEN。
# RAG_WEB_HOST=127.0.0.1
# RAG_WEB_PORT=7860
# 客户端访问时使用的主机名/IP（逗号分隔）
# RAG_ALLOWED_HOSTS=192.168.1.20,nas.lan
# 设置后 /api/* 需带 Authorization: Bearer <token>
# RAG_API_TOKEN=change-me

# ============================================================
# RAG MCP HTTP 服务（mcp_http_server.py，仅监听本机）
# ============================================================
# MCP_HTTP_PORT=8766

# ============================================================
# 绯梨个人记忆中枢（默认完全本地运行）
# ============================================================
# MEMORY_HUB_PORT=8771
# 以下路径注释里是默认值，填写时请换成实际的绝对路径
# MEMORY_HUB_INDEX_ROOT=%LOCALAPPDATA%\FeiliMemoryHub\indexes
# MEMORY_VAULT_ROOT=C:\Desktop\SecondBrain
# MEMORY_PROFILE_ROOT=%USERPROFILE%\.codex\memory
# MEMORY_ROLLOUT_ROOT=%USERPROFILE%\.codex\memories\rollout_summaries
# MEMORY_VAULT_INCLUDE_DIRS=01-Projects,02-Areas,03-Resources,Daily

# 只有显式开启后才会把记忆文本发送给硅基流动；仅存在共享 Key 不会自动启用。
# MEMORY_VECTOR_ENABLED=false
# MEMORY_RERANK_ENABLED=false
# MEMORY_EMBEDDING_API_KEY=
# MEMORY_RERANK_API_KEY=
# MEMORY_EMBEDDING_MODEL=BAAI/bge-m3
# MEMORY_RERANK_MODEL=BAAI/bge-reranker-v2-m3
# MEMORY_SILICONFLOW_API_BASE=https://api.siliconflow.cn/v1
